# Horilla HR — environment template
# Copy to .env and edit for your install:
#   cp .env.dist .env
#
# Local Docker (`make dev`) works WITHOUT this file — compose ships
# documented development defaults. Production (`make prod`) REQUIRES .env.

DJANGO_SETTINGS_MODULE=horilla.settings

# Django
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Production secrets require at least 50 characters; never reuse a candidate secret.
SECRET_KEY=change-me-to-a-long-random-value
# Use DEBUG=True for local tutorials; set False for production
DEBUG=True
# Comma-separated hostnames (do not use * in production)
# The private bridge also needs the Docker service hostname web in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Must include scheme (http:// or https://)
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Default for NEW THEVIPGROUP installations; review timezone/DST before changing
# an existing deployment. This template does not update stored agreements.
TIME_ZONE=Europe/Warsaw
# Set to production to force security gates even if DEBUG is accidentally True
# HORILLA_ENV=production

# TLS / reverse proxy (enable when HTTPS terminates in front of the app)
SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000

# Database initialization password (must be unique in production)
DB_INIT_PASSWORD=change-me-db-init-password

# Preferred: single DATABASE_URL (used by django-environ)
# Docker Compose default shape (host = service name `db`):
DATABASE_URL=postgres://horilla_user:change-me-db-password@db:5432/horilla_db

# PostgreSQL credentials used by docker-compose.prod.yml (keep in sync with DATABASE_URL)
POSTGRES_DB=horilla_db
POSTGRES_USER=horilla_user
POSTGRES_PASSWORD=change-me-db-password

# Entrypoint wait host/port (default: db:5432 for Docker Compose)
DB_HOST=db
DB_PORT=5432

# ---- OR discrete DB_* vars when DATABASE_URL is unset (host / SQLite) ----
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=TestDB.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=horilla_db
# DB_USER=horilla_user
# DB_PASSWORD=change-me-db-password
# DB_HOST=localhost
# DB_PORT=5432

# Redis cache (optional for runserver/SQLite; used when REDIS_URL is set)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# Gunicorn (optional)
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info
# GUNICORN_RELOAD=false

# /ready/ returns 503 until run_scheduler has registered jobs. Opt-in, and off
# by default: a stopped scheduler delays background jobs, while a 503 here can
# remove web from the load balancer and stop it serving requests entirely.
# Enable only where a failing readiness probe will not do that.
# HORILLA_REQUIRE_SCHEDULER=0

# THEVIPGROUP CareerHub / PeopleOps boundaries
# Internal Horilla Company id for THEVIPGROUP Sp. z o.o. (never public).
TVG_LEGAL_EMPLOYER_ID=
# Generate all four independently; each value is supplied only to PeopleOps and CareerHub.
CAREERHUB_INTERNAL_API_TOKEN=change-me-to-a-long-random-internal-token
CAREERHUB_IDENTITY_API_TOKEN=change-me-to-a-different-long-random-identity-token
CAREERHUB_APPLICATION_API_TOKEN=change-me-to-a-third-long-random-application-token
CAREERHUB_VERIFICATION_API_TOKEN=change-me-to-a-fourth-long-random-verification-token
CAREERHUB_INTERVIEW_API_TOKEN=change-me-to-a-fifth-long-random-interview-token
CAREERHUB_ARRANGEMENT_API_TOKEN=change-me-to-a-sixth-long-random-arrangement-token
# Generate independently from Horilla SECRET_KEY (at least 50 characters).
CAREERHUB_SECRET_KEY=change-me-to-a-separate-long-random-secret
CAREERHUB_ALLOWED_HOSTS=career.thevipgroup.eu
CAREERHUB_CSRF_TRUSTED_ORIGINS=https://career.thevipgroup.eu
CAREERHUB_PUBLIC_BASE_URL=https://career.thevipgroup.eu
CAREERHUB_PEOPLEOPS_API_URL=http://web:8000/internal/careerhub/v1
CAREERHUB_CONTACT_EMAIL=recruitment@thevipgroup.eu
CAREERHUB_GUNICORN_WORKERS=2
CAREERHUB_PRIVACY_NOTICE_VERSION=2026-10-25
CAREERHUB_PRIVATE_MEDIA_ROOT=/app/careerhub-private-media
TVG_VERIFICATION_PRIVATE_MEDIA_ROOT=/app/verification-private-media
TVG_ACCEPTANCE_PRIVATE_MEDIA_ROOT=/app/acceptance-private-media
TVG_ERASMUS_DOCUMENT_PRIVATE_MEDIA_ROOT=/app/erasmus-document-private-media
TVG_ONBOARDING_PRIVATE_MEDIA_ROOT=/app/onboarding-private-media
TVG_REPORTING_PRIVATE_MEDIA_ROOT=/app/reporting-private-media
TVG_OFFBOARDING_PRIVATE_MEDIA_ROOT=/app/offboarding-private-media
# Reliable lifecycle automation. Keep disabled until the staging Activepieces
# webhook and two independent HMAC secrets have been provisioned.
TVG_AUTOMATION_ENABLED=0
TVG_AUTOMATION_ENVIRONMENT=development
TVG_ACTIVEPIECES_WEBHOOK_URL=https://activepieces.example.invalid/webhooks/tvg-lifecycle
TVG_ACTIVEPIECES_OUTBOUND_SIGNING_SECRET=change-me-independent-outbound-hmac-secret
TVG_ACTIVEPIECES_CALLBACK_SIGNING_SECRET=change-me-independent-callback-hmac-secret
TVG_AUTOMATION_TRANSPORT_BACKEND=tvg_automation.transport.ActivepiecesWebhookTransport
TVG_AUTOMATION_MAX_ATTEMPTS=5
TVG_AUTOMATION_CALLBACK_MAX_SKEW_SECONDS=300
TVG_TRAINING_PROVIDER=disabled
# Install and review an approved adapter before selecting activepieces.
TVG_TRAINING_ACTIVEPIECES_BACKEND=tvg_training.integrations.DisabledTrainingProvider
# PeopleOps analytics publication. Keep disabled until the DBA has installed
# the least-privilege reader roles documented in METABASE_REPORTING.md.
TVG_ANALYTICS_EXPORT_PROVIDER=disabled
# Withhold person-linked external-report cells below this count.
TVG_ANALYTICS_MIN_CELL_SIZE=5
TVG_RECRUITMENT_FROM_EMAIL=recruitment@thevipgroup.eu
TVG_RECRUITMENT_REPLY_TO=recruitment@thevipgroup.eu
# Optional assistance only. Keep disabled until an approved provider adapter is configured.
TVG_REPORTING_AI_PROVIDER=disabled
# Keep external signing disabled until an approved self-hosted adapter is configured.
TVG_ERASMUS_SELF_HOSTED_SIGNING_BACKEND=tvg_erasmus.signing.DisabledSigningProvider
# NA10 requirements are not defined; this is an intentionally disabled adapter boundary.
TVG_ERASMUS_NA10_BACKEND=tvg_erasmus.integrations.DisabledExternalRequirementProvider
# Identity/mail providers remain fail-closed until authorized adapters are supplied.
TVG_ONBOARDING_ZOHO_BACKEND=tvg_onboarding.integrations.DisabledProvisioningProvider
TVG_ONBOARDING_SELF_HOSTED_BACKEND=tvg_onboarding.integrations.DisabledProvisioningProvider
# Keep evidence quarantined until an approved scanner backend is configured.
TVG_VERIFICATION_SCANNER_BACKEND=tvg_erasmus.scanning.DisabledScanner
# Number of trusted reverse-proxy addresses at the right of X-Forwarded-For.
# Verify this against the deployed Cloudflare Tunnel/nginx chain.
CAREERHUB_TRUSTED_PROXY_COUNT=1

# Dedicated CareerHub account database. Do not reuse PeopleOps credentials.
CAREERHUB_POSTGRES_DB=careerhub_db
CAREERHUB_POSTGRES_USER=careerhub_user
CAREERHUB_POSTGRES_PASSWORD=change-me-careerhub-db-password

# Dedicated CareerHub Redis instance for cache/rate-limit counters.
CAREERHUB_REDIS_PASSWORD=change-me-careerhub-redis-password

# Zoho SMTP transport for production. Development Compose overrides this with
# Django's in-memory backend, so development never sends real email.
CAREERHUB_EMAIL_HOST=smtp.example.invalid
CAREERHUB_EMAIL_PORT=587
CAREERHUB_EMAIL_HOST_USER=recruitment@thevipgroup.eu
CAREERHUB_EMAIL_HOST_PASSWORD=change-me-to-a-zoho-app-password
CAREERHUB_EMAIL_USE_TLS=1

# Optional AWS S3 media (see horilla/settings/addons.py)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_S3_ADDRESSING_STYLE=virtual
# MEDIA_URL=
# MEDIA_ROOT=
# NAMESPACE=

# Optional GCP media
# GOOGLE_APPLICATION_CREDENTIALS=
# GS_BUCKET_NAME=
# DEFAULT_FILE_STORAGE=horilla.horilla_backends_gcp.PrivateMediaStorage
# PeopleHub is a restricted runtime over the private Horilla database.
PEOPLEHUB_ALLOWED_HOSTS=people.thevipgroup.eu
PEOPLEHUB_CSRF_TRUSTED_ORIGINS=https://people.thevipgroup.eu
TVG_PEOPLEHUB_SSO_PROVIDER=disabled
TVG_PEOPLEHUB_AUTHENTIK_BACKEND=tvg_peoplehub.integrations.DisabledAuthentikProvider
PEOPLEHUB_GUNICORN_WORKERS=2
